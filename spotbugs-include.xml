<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- Security-focused bug patterns -->
    <Match>
        <Bug pattern="CIPHER_INTEGRITY,WEAK_FILENAMEUTILS,PATH_TRAVERSAL_IN,PATH_TRAVERSAL_OUT"/>
    </Match>
    <Match>
        <Bug pattern="SQL_NONCONSTANT_STRING_PASSED_TO_EXECUTE,SQL_PREPARED_STATEMENT_GENERATED_FROM_NONCONSTANT_STRING"/>
    </Match>
    <Match>
        <Bug pattern="XSS_REQUEST_PARAMETER_TO_SEND_ERROR,XSS_REQUEST_PARAMETER_TO_SERVLET_WRITER"/>
    </Match>
    <Match>
        <Bug pattern="HARD_CODE_PASSWORD,HARD_CODE_KEY"/>
    </Match>
    
    <!-- Null pointer and correctness issues -->
    <Match>
        <Bug pattern="NP_NULL_ON_SOME_PATH,RCN_REDUNDANT_NULLCHECK_WOULD_HAVE_BEEN_A_NPE,NP_ALWAYS_NULL"/>
    </Match>
    <Match>
        <Bug pattern="NP_NULL_PARAM_DEREF,NP_LOAD_OF_KNOWN_NULL_VALUE,NP_DEREFERENCE_OF_READLINE_VALUE"/>
    </Match>
    
    <!-- Performance issues -->
    <Match>
        <Bug pattern="DM_BOXED_PRIMITIVE_FOR_PARSING,DM_NUMBER_CTOR,DM_BOOLEAN_CTOR"/>
    </Match>
    <Match>
        <Bug pattern="SIC_INNER_SHOULD_BE_STATIC_ANON,SIC_INNER_SHOULD_BE_STATIC_NEEDS_THIS"/>
    </Match>
    
    <!-- Resource management -->
    <Match>
        <Bug pattern="OS_OPEN_STREAM,OS_OPEN_STREAM_EXCEPTION_PATH,OBL_UNSATISFIED_OBLIGATION"/>
    </Match>
    
    <!-- Concurrency issues -->
    <Match>
        <Bug pattern="IS2_INCONSISTENT_SYNC,ML_SYNC_ON_UPDATED_FIELD,UG_SYNC_SET_UNSYNC_GET"/>
    </Match>
    <Match>
        <Bug pattern="DC_DOUBLECHECK,LI_LAZY_INIT_STATIC,VO_VOLATILE_REFERENCE_TO_ARRAY"/>
    </Match>
    
    <!-- Code quality and maintainability -->
    <Match>
        <Bug pattern="URF_UNREAD_FIELD,UWF_UNWRITTEN_FIELD,SS_SHOULD_BE_STATIC"/>
    </Match>
    <Match>
        <Bug pattern="EQ_DOESNT_OVERRIDE_EQUALS,HE_EQUALS_USE_HASHCODE,HE_HASHCODE_USE_OBJECT_EQUALS"/>
    </Match>
</FindBugsFilter>
